{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Manga Reader",
  "version": "../package.json",
  "identifier": "com.mangareader.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Manga Reader",
        "width": 1280,
        "height": 900,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#18181b",
        "zoomHotkeysEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'; img-src 'self' blob: data: mangaimg: http://mangaimg.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://mangaimg.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGRTUzMzE5REJDNjAwRjMKUldSNkI4ZkQ5K3lYcWJvK0xXSHJvV3Rnd050aW0xNENqQVBWckpndlJvTFF6SjI4K3A1Qk9mUzkK",
      "endpoints": [
        "https://github.com/vivek-kumar-poddar/manga-reader/releases/latest/download/latest.json"
      ]
    }
  }
}
