{
  "name": "manga-reader",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:baseline": "npm run build && playwright test",
    "typecheck": "tsc -b",
    "format": "prettier --write src tests scripts *.ts *.json README.md AGENTS.md docs/*.md",
    "format:check": "prettier --check src tests scripts *.ts *.json README.md AGENTS.md docs/*.md",
    "test:limits": "playwright test --project=limits",
    "test:validation": "playwright test --config=playwright.unit.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-select": "2.1.6",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "cross-env": "^10.1.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "prettier": "3.9.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0"
  }
}
